{
  "name": "cts-dc-opsdesk",
  "version": "0.1.0",
  "private": true,
  "description": "JSAN Data Center OpsDesk - ITSM + CMDB + monitoring integration platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*",
    "tools/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @cts-dc-opsdesk/api start:dev",
    "dev:web": "pnpm --filter @cts-dc-opsdesk/web dev",
    "dev:worker": "pnpm --filter @cts-dc-opsdesk/worker start:dev",
    "dev:collector": "pnpm --filter @cts-dc-opsdesk/collector start:dev",
    "dev:tls-proxy": "node scripts/dev-tls-proxy.mjs",
    "dev:site-lab": "pnpm --filter @cts-dc-opsdesk/site-lab build && pnpm --filter @cts-dc-opsdesk/site-lab start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @cts-dc-opsdesk/api prisma:generate",
    "prisma:migrate": "pnpm --filter @cts-dc-opsdesk/api prisma:migrate"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "glob@<10.5.0": "^10.5.0",
      "multer@<2.5.0": "^2.5.0",
      "picomatch@<4.0.4": "^4.0.7",
      "lodash@<4.18.0": "^4.18.1",
      "tmp@<0.2.6": "^0.2.7",
      "js-yaml@<4.3.2": "^4.3.2",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "brace-expansion@<2.0.0": "^1.1.20",
      "brace-expansion@>=2.0.0 <3.0.0": "^2.1.6",
      "brace-expansion@>=5.0.0 <5.0.11": "^5.0.11",
      "source-map-js@<1.2.2": "^1.2.2",
      "proxy-addr@<2.0.8": "^2.0.8",
      "tinypool@<2.1.2": "^2.1.2",
      "handlebars@<4.7.10": "^4.7.10",
      "body-parser@<1.20.9": "^1.20.9"
    }
  }
}
