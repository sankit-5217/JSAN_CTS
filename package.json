{
  "name": "cts-dc-opsdesk",
  "version": "0.1.0",
  "private": true,
  "description": "JSAN Data Center OpsDesk - ITSM + CMDB + monitoring integration platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @cts-dc-opsdesk/api start:dev",
    "dev:web": "pnpm --filter @cts-dc-opsdesk/web dev",
    "dev:worker": "pnpm --filter @cts-dc-opsdesk/worker start:dev",
    "dev:collector": "pnpm --filter @cts-dc-opsdesk/collector start:dev",
    "dev:tls-proxy": "node scripts/dev-tls-proxy.mjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "pnpm --filter @cts-dc-opsdesk/api prisma:generate",
    "prisma:migrate": "pnpm --filter @cts-dc-opsdesk/api prisma:migrate"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "glob@<10.5.0": "^10.5.0",
      "multer@<2.4.0": "^2.4.0",
      "picomatch@<4.0.4": "^4.0.7",
      "lodash@<4.18.0": "^4.18.1",
      "tmp@<0.2.6": "^0.2.7",
      "js-yaml@<4.3.2": "^4.3.2"
    }
  }
}
