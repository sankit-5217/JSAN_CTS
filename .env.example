# --- Database ---
DATABASE_URL=postgresql://opsdesk:opsdesk@localhost:5432/opsdesk?schema=public

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=opsdesk-attachments
S3_ACCESS_KEY=opsdesk
S3_SECRET_KEY=opsdesk-secret

# --- API ---
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173
# In-app notification bell: rows older than this many days are purged daily (default 90).
NOTIFICATION_RETENTION_DAYS=90

# --- Auth ---
# Sign-in is email + password only. A Super Admin adds users with a starting
# password (changed at first sign-in) or an emailed invite (the worker sends
# invites/resets — see SMTP_* below). Seeded demo accounts use the password
# printed by `pnpm prisma:seed` (default OpsDesk-Demo-2026!).
# Production: long random JWT_SECRET, https URLs — the API refuses to start otherwise.
# The web app's origin: invite and password-reset links land here.
WEB_APP_URL=http://localhost:5173
# This API's public origin (used in the agent installer one-liners).
API_PUBLIC_URL=http://localhost:3000
JWT_SECRET=change-me-dev-only

# --- Worker ---
WORKER_CONCURRENCY=5
# Outbound email (invites, password resets, notifications). Unset SMTP_HOST =
# emails are printed to the worker log instead of sent (local dev).
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (465); otherwise STARTTLS is required.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JSAN OpsDesk <opsdesk@example.com>
# Scheduled worker -> API calls (warranty resync). Leave unset to disable that job.
# OPSDESK_SERVICE_TOKEN: an API token (odk_...) created under Administration ->
# Users -> Tokens, for a service account holding a vendor-write role.
OPSDESK_API_URL=http://localhost:3000/api/v1
OPSDESK_SERVICE_TOKEN=
# Optional cron override for the nightly warranty resync (default: 0 3 * * *).
WARRANTY_SYNC_CRON=0 3 * * *

# --- Vendor warranty providers (vendors module) ---
# Each provider is registered only when its key is present. Outside production
# (or with WARRANTY_STUB=1) a deterministic stub fills in so demos show coverage.
DELL_WARRANTY_API_KEY=
# DELL_WARRANTY_BASE_URL=https://apigtwb2c.us.dell.com/PROD/sbil/v5
HPE_WARRANTY_API_KEY=
# HPE_WARRANTY_BASE_URL=https://warranty.api.hpe.com/productWarranty/v2
WARRANTY_STUB=0

# --- Web ---
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Integrations ---
# 32 random bytes, base64. Encrypts credentials kept in the database (e.g. the
# Zabbix API token entered on the Zabbix settings page). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored tokens unreadable; re-enter them on the settings page.
INTEGRATION_SECRETS_KEY=
# Seed-only default for the Zabbix API URL (editable later in the app).
ZABBIX_API_URL=http://127.0.0.1/zabbix/api_jsonrpc.php
