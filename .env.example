# --- Database ---
DATABASE_URL=postgresql://opsdesk:opsdesk@localhost:5432/opsdesk?schema=public

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=opsdesk-attachments
S3_ACCESS_KEY=opsdesk
S3_SECRET_KEY=opsdesk-secret

# --- API ---
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173
# In-app notification bell: rows older than this many days are purged daily (default 90).
NOTIFICATION_RETENTION_DAYS=90

# --- Auth: SSO via any OIDC IdP (Keycloak for dev, enterprise IdP in prod) ---
# SSO is off unless OIDC_ENABLED=true. Locally: `docker compose up keycloak`
# (dev users from infra/keycloak/opsdesk-realm.json, password opsdesk-dev).
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:8080/realms/opsdesk
OIDC_CLIENT_ID=opsdesk-web
OIDC_CLIENT_SECRET=change-me
# This API's callback, registered at the IdP. Must use the same host as the
# web app's VITE_API_BASE_URL (the login cookie is scoped to that host).
OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_PROVIDER_LABEL=Sign in with SSO
# Where the callback sends the browser back to (the web app's origin).
WEB_APP_URL=http://localhost:5173
JWT_SECRET=change-me-dev-only

# --- Worker ---
WORKER_CONCURRENCY=5
# Scheduled worker -> API calls (warranty resync). Leave unset to disable that job.
# The token must resolve to an active user holding a vendor-write role.
OPSDESK_API_URL=http://localhost:3000/api/v1
OPSDESK_SERVICE_TOKEN=
# Optional cron override for the nightly warranty resync (default: 0 3 * * *).
WARRANTY_SYNC_CRON=0 3 * * *

# --- Vendor warranty providers (vendors module) ---
# Each provider is registered only when its key is present. Outside production
# (or with WARRANTY_STUB=1) a deterministic stub fills in so demos show coverage.
DELL_WARRANTY_API_KEY=
# DELL_WARRANTY_BASE_URL=https://apigtwb2c.us.dell.com/PROD/sbil/v5
HPE_WARRANTY_API_KEY=
# HPE_WARRANTY_BASE_URL=https://warranty.api.hpe.com/productWarranty/v2
WARRANTY_STUB=0

# --- Web ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
