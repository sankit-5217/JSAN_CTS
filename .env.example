# --- Database ---
DATABASE_URL=postgresql://opsdesk:opsdesk@localhost:5432/opsdesk?schema=public

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=opsdesk-attachments
S3_ACCESS_KEY=opsdesk
S3_SECRET_KEY=opsdesk-secret

# --- API ---
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173
# In-app notification bell: rows older than this many days are purged daily (default 90).
NOTIFICATION_RETENTION_DAYS=90

# --- Auth ---
# Sign-in is email + password (invites/resets are emailed by the worker — see
# SMTP_* below) plus optional Google / Microsoft / GitHub. Seeded demo accounts
# use the password printed by `pnpm prisma:seed` (default OpsDesk-Demo-2026!).
# Production: long random JWT_SECRET, https URLs — the API refuses to start otherwise.
# The web app's origin: invite/reset links and social sign-ins land here.
WEB_APP_URL=http://localhost:5173
# This API's public origin (social callback URLs are built from it). Use the same
# host the web app calls the API on (VITE_API_BASE_URL) — the sign-in cookie is
# scoped to it. Callback: <API_PUBLIC_URL>/api/v1/auth/social/<google|microsoft|github>/callback
API_PUBLIC_URL=http://localhost:3000
# Each provider turns on when both its id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Required for Microsoft: your Entra tenant ID (GUID), or "consumers" for personal
# accounts. "common"/"organizations" are refused (any tenant could claim an email).
MICROSOFT_TENANT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub Enterprise Server only:
# GITHUB_WEB_URL=https://github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3
JWT_SECRET=change-me-dev-only

# --- Worker ---
WORKER_CONCURRENCY=5
# Outbound email (invites, password resets, notifications). Unset SMTP_HOST =
# emails are printed to the worker log instead of sent (local dev).
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (465); otherwise STARTTLS is required.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JSAN OpsDesk <opsdesk@example.com>
# Scheduled worker -> API calls (warranty resync). Leave unset to disable that job.
# OPSDESK_SERVICE_TOKEN: an API token (odk_...) created under Administration ->
# Users -> Tokens, for a service account holding a vendor-write role.
OPSDESK_API_URL=http://localhost:3000/api/v1
OPSDESK_SERVICE_TOKEN=
# Optional cron override for the nightly warranty resync (default: 0 3 * * *).
WARRANTY_SYNC_CRON=0 3 * * *

# --- Vendor warranty providers (vendors module) ---
# Each provider is registered only when its key is present. Outside production
# (or with WARRANTY_STUB=1) a deterministic stub fills in so demos show coverage.
DELL_WARRANTY_API_KEY=
# DELL_WARRANTY_BASE_URL=https://apigtwb2c.us.dell.com/PROD/sbil/v5
HPE_WARRANTY_API_KEY=
# HPE_WARRANTY_BASE_URL=https://warranty.api.hpe.com/productWarranty/v2
WARRANTY_STUB=0

# --- Web ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
