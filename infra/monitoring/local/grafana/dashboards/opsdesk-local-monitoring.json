{
  "uid": "opsdesk-local",
  "title": "OpsDesk local monitoring",
  "tags": ["opsdesk"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape targets",
      "description": "1 = Prometheus can scrape the target, 0 = down.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 16, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "up", "legendFormat": "{{job}}", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alerts firing (sent to OpsDesk)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (ci) (rate(windows_cpu_time_total{job=\"windows-host\", mode=\"idle\"}[2m])))",
          "legendFormat": "{{ci}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - windows_memory_physical_free_bytes{job=\"windows-host\"} / windows_memory_physical_total_bytes{job=\"windows-host\"})",
          "legendFormat": "{{ci}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disk free",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * windows_logical_disk_free_bytes{job=\"windows-host\", volume=~\"[A-Z]:\"} / windows_logical_disk_size_bytes{job=\"windows-host\", volume=~\"[A-Z]:\"}",
          "legendFormat": "{{volume}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network traffic",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(windows_net_bytes_received_total{job=\"windows-host\"}[2m]))",
          "legendFormat": "received"
        },
        {
          "refId": "B",
          "expr": "sum(rate(windows_net_bytes_sent_total{job=\"windows-host\"}[2m]))",
          "legendFormat": "sent"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Log lines per second, by file",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (filename) (rate({job=~\"devtools|monitoring\"}[1m]))",
          "legendFormat": "{{filename}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Logs (Postgres, Redis, MinIO and the monitoring stack)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 28 },
      "targets": [{ "refId": "A", "expr": "{job=~\"devtools|monitoring\"}" }],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
