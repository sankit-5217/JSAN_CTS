{
  "name": "@cts-dc-opsdesk/site-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only iDRAC/iLO simulators (Redfish + SNMP traps) and control panel for running the site collector end to end without hardware. Never deploy.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "net-snmp": "^3.26.3"
  },
  "devDependencies": {
    "@cts-dc-opsdesk/hpe-ilo-adapter": "workspace:*",
    "@cts-dc-opsdesk/redfish-adapter": "workspace:*",
    "@cts-dc-opsdesk/snmp-adapter": "workspace:*",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
