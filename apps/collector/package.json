{
  "name": "@cts-dc-opsdesk/collector",
  "version": "0.1.0",
  "private": true,
  "description": "Site collector — queries local Redfish/OME/iLO/SNMP endpoints, normalizes via the adapters, pushes events outbound to the OpsDesk API (ADR-004, spec §11)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@cts-dc-opsdesk/dell-ome-adapter": "workspace:*",
    "@cts-dc-opsdesk/hpe-ilo-adapter": "workspace:*",
    "@cts-dc-opsdesk/redfish-adapter": "workspace:*",
    "@cts-dc-opsdesk/shared-types": "workspace:*",
    "@cts-dc-opsdesk/snmp-adapter": "workspace:*",
    "net-snmp": "^3.26.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
