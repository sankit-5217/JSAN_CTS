// JSAN Data Center OpsDesk — Prisma schema
// Baseline tables per build spec §13. UUID primary keys internally,
// separate human-readable codes for UI. Timestamps stored in UTC.
// This is the Sprint 1-2 baseline: core identity, sites, CMDB and audit.
// Incident/SLA/alert/vendor tables are stubbed here for Sprint 4+ owners
// (see module TODO comments in src/modules/*) to extend without redesigning
// the schema shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  SERVICE_DESK_NOC
  SITE_ENGINEER
  INFRASTRUCTURE_LEAD
  VENDOR_COORDINATOR
  DELIVERY_OPS_MANAGER
  CLIENT_MANAGER_VIEWER
  AUDITOR_READ_ONLY
}

enum ManagedBy {
  JSAN
  CTS
  SHARED
  VENDOR
}

enum Criticality {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum CiType {
  SERVER
  FIREWALL
  SWITCH
  UPS
  PDU
  STORAGE
  SERVICE
  CIRCUIT
  VM
}

enum LifecycleStatus {
  PLANNED
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum IncidentStatus {
  NEW
  ASSIGNED
  ACKNOWLEDGED
  IN_PROGRESS
  PENDING_VENDOR
  PENDING_CUSTOMER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum Priority {
  P1
  P2
  P3
  P4
}

// Problem/RCA lifecycle (spec §10.5, owner: Dev B). Distinct from incident
// status — closing an incident never changes a problem's status.
enum ProblemStatus {
  OPEN
  INVESTIGATING
  KNOWN_ERROR
  RESOLVED
  CLOSED
}

enum ProblemLinkType {
  INCIDENT
  CHANGE
}

enum AlertSeverity {
  CRITICAL
  HIGH
  WARNING
  INFO
}

enum AlertState {
  OPEN
  ACKNOWLEDGED
  RECOVERED
}

enum WorklogActivityType {
  REMOTE_WORK
  ONSITE
  TRAVEL
  VENDOR_CALL
  TESTING
  WAITING
  OTHER
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  UNKNOWN
}

enum DispatchStatus {
  REQUESTED
  APPROVED
  SHIPPED
  DELIVERED
  INSTALLED
  RETURNED
}

enum ChangeType {
  STANDARD
  NORMAL
  EMERGENCY
}

// ---------------------------------------------------------------------------
// Identity & access (owner: Dev A / auth module)
// ---------------------------------------------------------------------------

model User {
  id          String   @id @default(uuid())
  idpSubject  String   @unique @map("idp_subject")
  // OIDC issuer this user's idpSubject belongs to. NULL = not yet linked to
  // an SSO identity (a pre-provisioned/seeded user): the first successful SSO
  // login matching the user's email links it; after that only (issuer, sub)
  // is trusted, never the email alone.
  idpIssuer   String?  @map("idp_issuer")
  email       String   @unique
  displayName String   @map("display_name")
  role        UserRole
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  incidentsOwned      Incident[]           @relation("IncidentOwner")
  incidentsReported   Incident[]           @relation("IncidentReportedBy")
  worklogs            Worklog[]
  auditEvents         AuditEvent[]
  siteAccess          UserSiteAccess[]
  attachments         Attachment[]
  deletedAttachments  Attachment[]         @relation("AttachmentDeletedBy")
  supportGroupMembers SupportGroupMember[]
  engineerShifts      EngineerShift[]
  userSkills          UserSkill[]
  inAppNotifications  InAppNotification[]
  routingOffers       RoutingOffer[]
  ssoLoginCodes       SsoLoginCode[]

  @@map("users")
}

/// Single-use handoff between the OIDC callback (API origin) and the web
/// app: the callback redirects the browser with a random code, the web app
/// trades it for the app JWT via POST /auth/oidc/exchange. Only the SHA-256
/// of the code is stored; rows expire after ~60s and are consumed once.
model SsoLoginCode {
  id         String    @id @default(uuid())
  codeHash   String    @unique @map("code_hash")
  userId     String    @map("user_id")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sso_login_codes")
}

/// Explicit site-scope grants (spec §4: most roles are "assigned sites"
/// only; a few roles — see AuthzService.ALL_SITES_ROLES — see every site
/// without needing rows here).
model UserSiteAccess {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  siteId    String   @map("site_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  site Site @relation(fields: [siteId], references: [id])

  @@unique([userId, siteId])
  @@index([siteId])
  @@map("user_site_access")
}

// ---------------------------------------------------------------------------
// Sites & organization (owner: Dev A / sites module)
// ---------------------------------------------------------------------------

model Site {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  timezone  String
  is247     Boolean  @default(false) @map("is_24x7")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts           SiteContact[]
  supportCalendars   SupportCalendar[]
  configurationItems ConfigurationItem[]
  incidents          Incident[]
  userAccess         UserSiteAccess[]
  racks              Rack[]
  engineerShifts     EngineerShift[]
  routingPolicy      RoutingPolicy?

  @@map("sites")
}

model SiteContact {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  name      String
  role      String
  email     String?
  phone     String?
  isOnCall  Boolean  @default(false) @map("is_on_call")
  createdAt DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@map("site_contacts")
}

model SupportCalendar {
  id            String     @id @default(uuid())
  siteId        String     @map("site_id")
  name          String
  businessStart String     @map("business_start") // "09:00"
  businessEnd   String     @map("business_end") // "18:00"
  workdays      Int[]      @map("workdays") // 0=Sun .. 6=Sat
  holidays      DateTime[]
  is247         Boolean    @default(false) @map("is_24x7")

  site Site @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@map("support_calendars")
}

model SupportGroup {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  incidents     Incident[]
  members       SupportGroupMember[]
  categoryTeams CategoryTeam[]

  @@map("support_groups")
}

/// Which support group (team) owns an incident category, e.g.
/// STORAGE_FAILURE -> Storage team. Owned by the routing module: offers and
/// suggestions prefer that team's members, and an accepted offer records the
/// team on the incident. One team per category (case-insensitive, enforced
/// by the routing service). Deleting the group removes its mappings.
model CategoryTeam {
  id        String   @id @default(uuid())
  category  String   @unique
  groupId   String   @map("group_id")
  createdAt DateTime @default(now()) @map("created_at")

  group SupportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("category_teams")
}

/// Who's actually on a support group's roster — SupportGroup itself has no
/// members concept without this, which meant assigning an incident to a
/// group had no one to notify (spec gap; see incidents.service.ts's
/// notifyGroupAssignment). Same explicit-join-table shape as UserSiteAccess.
model SupportGroupMember {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  group SupportGroup @relation(fields: [groupId], references: [id])
  user  User         @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
  @@map("support_group_members")
}

/// A recurring weekly duty window for one engineer at one site — e.g. "Sam,
/// SITE01, Mon-Fri 06:00-14:00". `daysOfWeek` uses the same 0=Sun..6=Sat
/// convention as SupportCalendar.workdays (calendar.util.ts's `weekday % 7`).
/// `startTime`/`endTime` are "HH:MM" local to the site's own timezone, same
/// representation as SupportCalendar.businessStart/businessEnd — interpreted
/// as an overnight wrap (e.g. 22:00-06:00) whenever startTime > endTime.
/// `isOnCall` distinguishes a normal working shift from an on-call/escalation
/// window; `isActive` retires a shift without losing its history (no hard
/// delete, same posture as AlertRule/SlaPolicy — deactivate, don't delete).
model EngineerShift {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  siteId     String   @map("site_id")
  label      String
  daysOfWeek Int[]    @map("days_of_week")
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  isOnCall   Boolean  @default(false) @map("is_on_call")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  site Site @relation(fields: [siteId], references: [id])

  @@index([userId])
  @@index([siteId])
  @@map("engineer_shifts")
}

/// Skill taxonomy (Phase 1 of skill-based routing) — admin-managed tags like
/// "Windows", "Storage", "Backup", never hard-coded (CLAUDE.md: config over
/// hard-code). Soft-deactivate only, same posture as AlertRule/SlaPolicy —
/// a retired skill stays on historical assignments, just stops being
/// offerable for new ones.
model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userSkills           UserSkill[]
  categoryRequirements CategorySkillRequirement[]

  @@map("skills")
}

/// Which engineers have which skills — a plain membership join, same
/// hard-delete-on-remove posture as SupportGroupMember (removing a skill
/// from an engineer is "they no longer have it," not a historical record
/// worth soft-deleting; the audit log already captures the removal event).
model UserSkill {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  skillId   String   @map("skill_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

/// Phase 2 of skill-based routing: which skill(s) an incident category
/// requires — admin-configured, never hard-coded (CLAUDE.md: config over
/// hard-code). `category` mirrors Incident.category's own free-text field
/// (no enum exists there either); matched case-insensitively by the
/// routing module's suggestions (Phase 3 — suggest only, never auto-assigns).
model CategorySkillRequirement {
  id        String   @id @default(uuid())
  category  String
  skillId   String   @map("skill_id")
  createdAt DateTime @default(now()) @map("created_at")

  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([category, skillId])
  @@index([skillId])
  @@map("category_skill_requirements")
}

/// Per-site skill-based routing settings. Owned by the routing module; one
/// row per site, created on first write. A site with no row is treated as
/// autoAssignEnabled = false, so the feature is opt-in per site (config
/// over hard-code, CLAUDE.md). When on, a new incident is offered to the
/// top-ranked engineer, who has the priority's offer timeout to accept
/// before it moves to the next candidate (see RoutingOffer).
model RoutingPolicy {
  id                    String   @id @default(uuid())
  siteId                String   @unique @map("site_id")
  autoAssignEnabled     Boolean  @default(false) @map("auto_assign_enabled")
  /// Minutes an engineer has to accept an offer, by incident priority.
  offerTimeoutP1Minutes Int      @default(2) @map("offer_timeout_p1_minutes")
  offerTimeoutP2Minutes Int      @default(5) @map("offer_timeout_p2_minutes")
  offerTimeoutP3Minutes Int      @default(10) @map("offer_timeout_p3_minutes")
  offerTimeoutP4Minutes Int      @default(15) @map("offer_timeout_p4_minutes")
  /// How much one open incident of each priority counts toward an
  /// engineer's workload when ranking candidates.
  workloadWeightP1      Int      @default(4) @map("workload_weight_p1")
  workloadWeightP2      Int      @default(3) @map("workload_weight_p2")
  workloadWeightP3      Int      @default(2) @map("workload_weight_p3")
  workloadWeightP4      Int      @default(1) @map("workload_weight_p4")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id])

  @@map("routing_policies")
}

enum RoutingOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  /// The ticket was assigned or moved on some other way while the offer
  /// was open.
  CANCELLED
}

/// One offer of a NEW incident to one engineer. Owned by the routing
/// module. The incident itself stays NEW and unowned until an offer is
/// accepted; at most one offer per incident is PENDING at a time (enforced
/// by the routing service's conditional writes). Declined and expired
/// offers stay as history so the next round skips those engineers.
model RoutingOffer {
  id            String             @id @default(uuid())
  incidentId    String             @map("incident_id")
  userId        String             @map("user_id")
  status        RoutingOfferStatus @default(PENDING)
  expiresAt     DateTime           @map("expires_at")
  respondedAt   DateTime?          @map("responded_at")
  declineReason String?            @map("decline_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  incident Incident @relation(fields: [incidentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([incidentId, status])
  @@index([status, expiresAt])
  @@index([userId, status])
  @@map("routing_offers")
}

/// What an in-app notification is about: the subset of the email
/// notification kinds that also land in the web app's bell.
enum InAppNotificationKind {
  INCIDENT_CREATED
  INCIDENT_ASSIGNED
  INCIDENT_GROUP_ASSIGNED
  INCIDENT_STATUS_CHANGED
  INCIDENT_COMMENT_ADDED
  SLA_WARNING
  SLA_BREACHED
  INCIDENT_OFFERED
  INCIDENT_OFFER_UNACCEPTED
  ALERT_RECOVERED
}

/// One entry in a user's notification bell. Owned by the inbox module;
/// written best-effort next to the matching email, after the triggering
/// mutation has committed. `dedupeKey` makes a repeated write of the same
/// event for the same user a no-op. Rows older than
/// NOTIFICATION_RETENTION_DAYS (default 90) are purged daily.
model InAppNotification {
  id         String                @id @default(uuid())
  userId     String                @map("user_id")
  kind       InAppNotificationKind
  title      String
  body       String?
  entityType String                @map("entity_type")
  entityId   String                @map("entity_id")
  dedupeKey  String                @map("dedupe_key")
  readAt     DateTime?             @map("read_at")
  createdAt  DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("in_app_notifications")
}

// ---------------------------------------------------------------------------
// CMDB (owner: Dev A / cmdb module) — spec §9
// ---------------------------------------------------------------------------

/// Physical placement, not a monitorable asset — spec's Figure 2 hierarchy
/// (Site -> Rack -> Server/Switch/UPS) treats a rack as containment, so it
/// stays out of CiType/ConfigurationItem and out of CI search results.
model Rack {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  rackCode  String   @map("rack_code")
  name      String?
  location  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site               Site                @relation(fields: [siteId], references: [id])
  configurationItems ConfigurationItem[]

  @@unique([siteId, rackCode])
  @@map("racks")
}

model ConfigurationItem {
  id                 String          @id @default(uuid())
  ciCode             String          @unique @map("ci_code")
  siteId             String          @map("site_id")
  rackId             String?         @map("rack_id")
  ciType             CiType          @map("ci_type")
  name               String
  manufacturer       String?
  model              String?
  serialOrServiceTag String?         @map("serial_or_service_tag")
  managementAddress  String?         @map("management_address") // access-restricted; never exposed to customer viewer
  ownerGroupId       String?         @map("owner_group_id")
  managedBy          ManagedBy       @map("managed_by")
  criticality        Criticality
  lifecycleStatus    LifecycleStatus @map("lifecycle_status")
  metadata           Json? // vendor-specific fields only
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  site           Site            @relation(fields: [siteId], references: [id])
  rack           Rack?           @relation(fields: [rackId], references: [id])
  incidents      Incident[]
  alerts         Alert[]
  healthSnapshot HealthSnapshot?
  warranties     Warranty[]
  vendorCases    VendorCase[]

  parentOf CiRelation[] @relation("ParentCi")
  childOf  CiRelation[] @relation("ChildCi")

  @@index([siteId])
  @@index([rackId])
  @@map("configuration_items")
}

model CiRelation {
  id           String @id @default(uuid())
  parentCiId   String @map("parent_ci_id")
  childCiId    String @map("child_ci_id")
  relationType String @map("relation_type") // CONTAINS / DEPENDS_ON / RUNS_ON / USES

  parent ConfigurationItem @relation("ParentCi", fields: [parentCiId], references: [id])
  child  ConfigurationItem @relation("ChildCi", fields: [childCiId], references: [id])

  @@unique([parentCiId, childCiId, relationType])
  @@map("ci_relations")
}

model HealthSnapshot {
  id               String    @id @default(uuid())
  ciId             String    @unique @map("ci_id")
  overallHealth    String    @map("overall_health") // HEALTHY / WARNING / CRITICAL / UNKNOWN / MAINTENANCE
  details          Json?
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  // Alert.externalEventId of the currently-open hardware-health alert this CI's
  // WARNING/CRITICAL streak opened (see MonitoringService.syncHealthAlert) — null
  // when the CI is HEALTHY/UNKNOWN/MAINTENANCE with no open episode. Lets repeated
  // bad polls update the same alert row and the eventual HEALTHY poll close it,
  // instead of a fresh alert per poll.
  openAlertEventId String?   @map("open_alert_event_id")

  ci ConfigurationItem @relation(fields: [ciId], references: [id])

  @@map("health_snapshots")
}

model Warranty {
  id        String         @id @default(uuid())
  ciId      String         @map("ci_id")
  status    WarrantyStatus
  provider  String?
  expiresAt DateTime?      @map("expires_at")
  createdAt DateTime       @default(now()) @map("created_at")

  ci ConfigurationItem @relation(fields: [ciId], references: [id])

  @@index([ciId])
  @@map("warranties")
}

// ---------------------------------------------------------------------------
// Incidents (owner: Dev A / incidents, worklogs, sla modules) — spec §10.3,
// §10.7, §10.8, §15
// ---------------------------------------------------------------------------

model Incident {
  id                 String         @id @default(uuid())
  incidentNo         String         @unique @map("incident_no")
  siteId             String         @map("site_id")
  ciId               String?        @map("ci_id")
  status             IncidentStatus @default(NEW)
  priority           Priority
  category           String
  impact             String
  urgency            String
  shortDescription   String         @map("short_description")
  ownerGroupId       String?        @map("owner_group_id")
  ownerUserId        String?        @map("owner_user_id")
  // Set only when this incident came in via POST /incidents/customer-report —
  // null for internally-created incidents (spec §10.3: who to notify back on
  // status/comment updates for a self-service ticket).
  reportedByUserId   String?        @map("reported_by_user_id")
  acknowledgedAt     DateTime?      @map("acknowledged_at")
  resolutionCategory String?        @map("resolution_category")
  rootCauseSummary   String?        @map("root_cause_summary")
  restoredAt         DateTime?      @map("restored_at")
  closedAt           DateTime?      @map("closed_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  site       Site               @relation(fields: [siteId], references: [id])
  ci         ConfigurationItem? @relation(fields: [ciId], references: [id])
  owner      User?              @relation("IncidentOwner", fields: [ownerUserId], references: [id])
  ownerGroup SupportGroup?      @relation(fields: [ownerGroupId], references: [id])
  reportedBy User?              @relation("IncidentReportedBy", fields: [reportedByUserId], references: [id])

  events        IncidentEvent[]
  comments      IncidentComment[]
  worklogs      Worklog[]
  slaInstances  SlaInstance[]
  vendorCases   VendorCase[]
  routingOffers RoutingOffer[]

  @@index([siteId])
  @@index([status])
  @@map("incidents")
}

/// Append-only incident timeline — never mutate or delete a row.
model IncidentEvent {
  id         String   @id @default(uuid())
  incidentId String   @map("incident_id")
  eventType  String   @map("event_type") // STATUS_CHANGE / OWNER_CHANGE / SLA_EVENT / COMMENT / WORKLOG / VENDOR_UPDATE / ATTACHMENT / ATTACHMENT_REMOVED
  actorId    String?  @map("actor_id")
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@map("incident_events")
}

model IncidentComment {
  id         String   @id @default(uuid())
  incidentId String   @map("incident_id")
  authorId   String   @map("author_id")
  body       String
  isInternal Boolean  @default(true) @map("is_internal") // internal engineer note vs customer-visible
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@map("incident_comments")
}

/// Engineer clocking — immutable identity, corrections tracked via edit_reason
/// + audit_event, never a mutable stopwatch (spec §10.7).
model Worklog {
  id              String              @id @default(uuid())
  incidentId      String              @map("incident_id")
  engineerId      String              @map("engineer_id")
  activityType    WorklogActivityType @map("activity_type")
  startedAt       DateTime            @map("started_at")
  endedAt         DateTime?           @map("ended_at")
  durationMinutes Int?                @map("duration_minutes") // derived server-side; never negative
  billable        Boolean?            @map("billable_or_contract_flag")
  notes           String?
  editReason      String?             @map("edit_reason") // mandatory when correcting a submitted worklog
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  incident Incident @relation(fields: [incidentId], references: [id])
  engineer User     @relation(fields: [engineerId], references: [id])

  @@index([incidentId])
  @@map("worklogs")
}

// ---------------------------------------------------------------------------
// SLA (owner: Dev A / sla module) — spec §10.8
// ---------------------------------------------------------------------------

model SlaPolicy {
  id                          String    @id @default(uuid())
  name                        String
  priority                    Priority
  ackTargetMinutes            Int       @map("ack_target_minutes")
  resolveTargetMinutes        Int       @map("resolve_target_minutes")
  usesBusinessCalendar        Boolean   @default(false) @map("uses_business_calendar")
  escalationThresholdsPercent Int[]     @default([50, 75, 90]) @map("escalation_thresholds_percent")
  pausesOnPendingVendor       Boolean   @default(true) @map("pauses_on_pending_vendor")
  pausesOnPendingCustomer     Boolean   @default(true) @map("pauses_on_pending_customer")
  effectiveFrom               DateTime  @map("effective_from")
  effectiveTo                 DateTime? @map("effective_to")
  isActive                    Boolean   @default(true) @map("is_active")

  slaInstances SlaInstance[]

  @@index([priority, isActive])
  @@map("sla_policies")
}

/// pausedAt is the start of the *current* pause window (null when not
/// paused); pausedMinutes is the cumulative total, only incremented on
/// resume — never derived from pausedAt alone, so a mid-pause read of
/// resolveDueAt stays stable. firedMilestones dedupes the escalation scan
/// (spec §10.8: "store exact timer events") so a threshold is recorded and
/// notified exactly once, e.g. "ACK_75", "RESOLVE_BREACH".
model SlaInstance {
  id              String    @id @default(uuid())
  incidentId      String    @map("incident_id")
  slaPolicyId     String    @map("sla_policy_id")
  ackDueAt        DateTime? @map("ack_due_at")
  ackedAt         DateTime? @map("acked_at")
  resolveDueAt    DateTime? @map("resolve_due_at")
  resolvedAt      DateTime? @map("resolved_at")
  pausedAt        DateTime? @map("paused_at")
  pausedMinutes   Int       @default(0) @map("paused_minutes")
  firedMilestones String[]  @default([]) @map("fired_milestones")
  breached        Boolean   @default(false)

  incident  Incident  @relation(fields: [incidentId], references: [id])
  slaPolicy SlaPolicy @relation(fields: [slaPolicyId], references: [id])

  @@index([incidentId])
  @@map("sla_instances")
}

// ---------------------------------------------------------------------------
// Alerts (owner: Dev B / alerts module) — spec §10.9-10.10
// ---------------------------------------------------------------------------

model Alert {
  id                   String        @id @default(uuid())
  externalEventId      String        @map("external_event_id")
  source               String // ZABBIX / PROMETHEUS / REDFISH / SNMP / SYSLOG
  siteId               String?       @map("site_id")
  ciId                 String?       @map("ci_id")
  alertType            String        @map("alert_type")
  severity             AlertSeverity
  fingerprint          String
  firstSeenAt          DateTime      @map("first_seen_at")
  lastSeenAt           DateTime      @map("last_seen_at")
  state                AlertState    @default(OPEN)
  rawReference         String?       @map("raw_reference") // pointer, not unlimited raw payload storage
  // Set once when the alert is attached to a still-open incident on the same CI
  // (spec §10.10). Scalar, no FK relation: the incidents module owns that table,
  // correlation only reads it. Link-only — correlation never opens or mutates a
  // ticket.
  correlatedIncidentId String?       @map("correlated_incident_id")

  ci ConfigurationItem? @relation(fields: [ciId], references: [id])

  @@unique([source, externalEventId])
  @@index([fingerprint])
  @@index([correlatedIncidentId])
  @@map("alerts")
}

/// Tunable ingestion policy (spec §10.10 "config over hard-code"): flapping
/// detection, which severities page the NOC, whether a live alert is
/// auto-correlated to an open incident, and whether an approved maintenance
/// window on the CI suppresses auto-ticketing (§10.10 rule 5) or only labels
/// the alert expected. `siteId` / `alertType` optionally scope a rule; the
/// alerts module resolves the most specific active match per ingest
/// (site+type > site > type > global), falling back to code defaults, behind
/// a short in-memory cache.
model AlertRule {
  id                                  String          @id @default(uuid())
  name                                String
  siteId                              String?         @map("site_id")
  alertType                           String?         @map("alert_type")
  flappingThreshold                   Int             @default(3) @map("flapping_threshold")
  flappingWindowMinutes               Int             @default(30) @map("flapping_window_minutes")
  pagingSeverities                    AlertSeverity[] @default([CRITICAL]) @map("paging_severities")
  autoCorrelateIncidents              Boolean         @default(true) @map("auto_correlate_incidents")
  suppressAutoTicketDuringMaintenance Boolean         @default(true) @map("suppress_auto_ticket_during_maintenance")
  /// Severities that open a new incident when the CI has no open one.
  /// Empty turns auto-creation off for this rule's scope.
  autoCreateSeverities                AlertSeverity[] @default([CRITICAL]) @map("auto_create_severities")
  /// Category for auto-created incidents (drives skill-based routing).
  /// Null means OTHER.
  incidentCategory                    String?         @map("incident_category")
  /// Priority for auto-created incidents. Null means derived from the alert
  /// severity (CRITICAL P1, HIGH P2, WARNING P3, INFO P4).
  incidentPriority                    Priority?       @map("incident_priority")
  isActive                            Boolean         @default(true) @map("is_active")
  createdAt                           DateTime        @default(now()) @map("created_at")
  updatedAt                           DateTime        @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([siteId])
  @@map("alert_rules")
}

// ---------------------------------------------------------------------------
// Vendors / RMA (owner: Dev B / vendors module) — spec §10.13
// ---------------------------------------------------------------------------

model Vendor {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String // DELL / HPE / ISP / LOCAL
  createdAt DateTime @default(now()) @map("created_at")

  vendorCases VendorCase[]

  @@map("vendors")
}

model VendorCase {
  id               String          @id @default(uuid())
  vendorCaseNo     String          @unique @map("vendor_case_no")
  vendorId         String          @map("vendor_id")
  linkedIncidentId String?         @map("linked_incident_id")
  ciId             String?         @map("ci_id")
  warrantyStatus   WarrantyStatus  @default(UNKNOWN) @map("warranty_status")
  openedAt         DateTime        @default(now()) @map("opened_at")
  acknowledgedAt   DateTime?       @map("acknowledged_at")
  rmaRequired      Boolean         @default(false) @map("rma_required")
  replacementPart  String?         @map("replacement_part")
  dispatchStatus   DispatchStatus? @map("dispatch_status")
  vendorEta        DateTime?       @map("vendor_eta")
  closedAt         DateTime?       @map("closed_at")
  outcome          String?

  vendor   Vendor             @relation(fields: [vendorId], references: [id])
  incident Incident?          @relation(fields: [linkedIncidentId], references: [id])
  ci       ConfigurationItem? @relation(fields: [ciId], references: [id])
  updates  VendorCaseUpdate[]

  @@index([linkedIncidentId])
  @@map("vendor_cases")
}

/// Append-only vendor update history.
model VendorCaseUpdate {
  id           String   @id @default(uuid())
  vendorCaseId String   @map("vendor_case_id")
  note         String
  createdAt    DateTime @default(now()) @map("created_at")

  vendorCase VendorCase @relation(fields: [vendorCaseId], references: [id])

  @@map("vendor_case_updates")
}

// ---------------------------------------------------------------------------
// Changes / knowledge / risk (owner: Dev B) — spec §10.5, §10.6, §10.14,
// §10.15
// ---------------------------------------------------------------------------

/// Formal RCA record for repeated or major incidents (spec §10.5). Owns its
/// own action items and the links to related incidents/changes, so linking
/// never edits another module's table. Closing an incident must never
/// auto-close a problem — that rule lives in this module only.
model Problem {
  id               String        @id @default(uuid())
  problemNo        String        @unique @map("problem_no")
  title            String
  status           ProblemStatus @default(OPEN)
  priority         Priority?
  symptoms         String
  knownError       String?       @map("known_error")
  rootCause        String?       @map("root_cause")
  correctiveAction String?       @map("corrective_action")
  preventiveAction String?       @map("preventive_action")
  ownerUserId      String?       @map("owner_user_id")
  dueDate          DateTime?     @map("due_date")
  resolvedAt       DateTime?     @map("resolved_at")
  closedAt         DateTime?     @map("closed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  actionItems ProblemActionItem[]
  links       ProblemLink[]

  @@index([status])
  @@map("problems")
}

/// A corrective / preventive task on a problem, tracked to completion (spec §10.5).
model ProblemActionItem {
  id             String    @id @default(uuid())
  problemId      String    @map("problem_id")
  description    String
  assigneeUserId String?   @map("assignee_user_id")
  dueDate        DateTime? @map("due_date")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id])

  @@index([problemId])
  @@map("problem_action_items")
}

/// Link from a problem to a related incident or change (spec §10.5). A plain
/// join row (entityId is not an FK) so the problems module never writes to the
/// incidents or changes tables.
model ProblemLink {
  id         String          @id @default(uuid())
  problemId  String          @map("problem_id")
  entityType ProblemLinkType @map("entity_type")
  entityId   String          @map("entity_id")
  createdAt  DateTime        @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id])

  @@unique([problemId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("problem_links")
}

model Change {
  id                 String     @id @default(uuid())
  changeType         ChangeType @map("change_type")
  reason             String
  implementationPlan String     @map("implementation_plan")
  validationPlan     String     @map("validation_plan")
  rollbackPlan       String     @map("rollback_plan")
  risk               String
  windowStart        DateTime   @map("window_start")
  windowEnd          DateTime   @map("window_end")
  // Who raised the change — separate from approverId so approve() can refuse
  // to let the raiser approve their own change (separation of duties).
  // Nullable only because rows created before this column existed have none.
  createdBy          String?    @map("created_by")
  approverId         String?    @map("approver_id")
  outcome            String?
  // CIs this change touches. Empty = a site-wide window. Lets the
  // alert-suppression feed answer "is CI X under maintenance right now?"
  // rather than only keying off ci.lifecycleStatus.
  affectedCiIds      String[]   @default([]) @map("affected_ci_ids")
  createdAt          DateTime   @default(now()) @map("created_at")

  @@map("changes")
}

model KnowledgeArticle {
  id               String    @id @default(uuid())
  title            String
  body             String
  version          Int       @default(1)
  ownerId          String?   @map("owner_id")
  // Scope & linkage (spec §10.14). siteId null = global runbook; set = a
  // site-specific SOP. incidentCategory / ciType tie the article to the kind
  // of incident and hardware it applies to.
  siteId           String?   @map("site_id")
  incidentCategory String?   @map("incident_category")
  ciType           CiType?   @map("ci_type")
  approvalState    String    @default("DRAFT") @map("approval_state") // DRAFT / APPROVED
  reviewDueAt      DateTime? @map("review_due_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([siteId])
  @@map("knowledge_articles")
}

model Risk {
  id          String    @id @default(uuid())
  siteId      String?   @map("site_id")
  description String
  likelihood  Int
  impact      Int
  score       Int
  mitigation  String?
  evidence    String?
  ownerId     String?   @map("owner_id")
  dueDate     DateTime? @map("due_date")
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("risks")
}

/// Business-continuity plan for a site or a named service (spec §10.15):
/// recovery strategy, alternate site, RTO/RPO, contacts and the test cadence
/// (last tested / next due). "Readiness" (untested / test overdue / ready) is
/// derived at read time from the test dates, not stored. Owner: Dev B / risks
/// module. `siteId` is a bare scalar, same as `Risk.siteId`.
model BcpPlan {
  id                        String    @id @default(uuid())
  name                      String
  siteId                    String?   @map("site_id")
  serviceName               String?   @map("service_name")
  recoveryStrategy          String    @map("recovery_strategy")
  alternateSite             String?   @map("alternate_site")
  rtoMinutes                Int       @map("rto_minutes")
  rpoMinutes                Int       @map("rpo_minutes")
  targetAvailabilityPercent Float?    @map("target_availability_percent")
  residualRisk              String?   @map("residual_risk")
  contacts                  String?
  ownerId                   String?   @map("owner_id")
  lastTestedAt              DateTime? @map("last_tested_at")
  nextTestDueAt             DateTime? @map("next_test_due_at")
  isActive                  Boolean   @default(true) @map("is_active")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@index([siteId])
  @@index([isActive])
  @@map("bcp_plans")
}

// ---------------------------------------------------------------------------
// Cross-cutting (owner: Dev A / audit module) — spec §17
// ---------------------------------------------------------------------------

/// Append-only compliance trail for every mutation across all modules.
model AuditEvent {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String
  before        Json?
  after         Json?
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_events")
}

model Attachment {
  id           String    @id @default(uuid())
  entityType   String    @map("entity_type") // INCIDENT / VENDOR_CASE / CHANGE / ...
  entityId     String    @map("entity_id")
  objectKey    String    @map("object_key") // S3/MinIO key
  contentType  String    @map("content_type")
  sizeBytes    Int       @map("size_bytes")
  sha256       String
  uploadedById String?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  // Soft delete only (spec's audit-everything rule) -- the row and the S3
  // object both stay; a removed attachment just stops appearing in the list
  // and can no longer be downloaded, same as this codebase's other
  // append-only records (worklogs correct, they don't get edited in place).
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?   @map("deleted_by_id")

  uploadedBy User? @relation(fields: [uploadedById], references: [id])
  deletedBy  User? @relation("AttachmentDeletedBy", fields: [deletedById], references: [id])

  @@index([entityType, entityId])
  @@map("attachments")
}
